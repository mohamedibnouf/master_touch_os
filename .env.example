# Master Touch OS — public + server environment

# ── Public (browser-safe) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Server-only (never expose to client bundles) ──────────────────
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: grant platform admin on first login when no admin exists yet
BOOTSTRAP_ADMIN_EMAIL=admin@mastertouch.sa

# ── Live integration tests (development / CI only) ────────────────
# Set LIVE_TEST_ENABLED=true to run tests/live/*.test.ts against real Supabase.
LIVE_TEST_ENABLED=false

# Optional direct Postgres URL for migration apply scripts (not used by the app)
# DATABASE_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres

# Test user password prefix — full password is {prefix}{role} e.g. MtTest1!admin
LIVE_TEST_PASSWORD_PREFIX=MtTest1!

# ── Phase 5.4 Management AI Analyst (server-only; never NEXT_PUBLIC_*) ──
# none = unavailable UI | mock = deterministic local provider (CI/E2E) | openai = OpenAI-compatible API
MANAGEMENT_AI_PROVIDER=none
# MANAGEMENT_AI_API_KEY=sk-...
# MANAGEMENT_AI_MODEL=gpt-4o-mini
# MANAGEMENT_AI_BASE_URL=https://api.openai.com/v1

# ── Phase 5.5 Document Intelligence (falls back to MANAGEMENT_AI_* if unset) ──
# DOCUMENT_AI_PROVIDER=mock
# DOCUMENT_AI_API_KEY=
# DOCUMENT_AI_MODEL=gpt-4o-mini

# ── Phase 5.6 Notification hub ──
# NOTIFICATION_EMAIL_PROVIDER=none
# RESEND_API_KEY=
# NOTIFICATION_EMAIL_FROM=Master Touch OS <noreply@notify.example.com>
# NOTIFICATION_EMAIL_REPLY_TO=
# RESEND_TIMEOUT_MS=8000
# NOTIFICATION_WHATSAPP_PROVIDER=none
# NOTIFICATION_PUSH_PROVIDER=none
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Vercel Cron sends Authorization: Bearer ${CRON_SECRET} on GET /api/internal/notifications/run
# CRON_SECRET=change-me-to-a-long-random-string
# NOTIFICATIONS_CRON_SECRET=

# ── Google Drive Connected Mode (Picker) — public browser identifiers only ──
# Enable only after Vercel has the OAuth client ID and restricted Picker API key.
# NEXT_PUBLIC_GOOGLE_PICKER_ENABLED=false
# NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=your-referrer-restricted-picker-api-key
# Do not set GOOGLE_OAUTH_CLIENT_SECRET, refresh tokens, or service account keys for this phase.

