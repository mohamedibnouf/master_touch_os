{
  "name": "master-touch-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'tests/live/**'",
    "test:live": "vitest run tests/live --fileParallelism=false --maxWorkers=1",
    "test:all": "vitest run --exclude 'tests/live/**' && vitest run tests/live --fileParallelism=false --maxWorkers=1",
    "test:watch": "vitest",
    "verify:schema": "npx tsx scripts/verify-schema.ts",
    "db:apply-phase2": "npx tsx scripts/apply-phase2-migrations.ts",
    "db:apply-phase5-061": "npx tsx scripts/apply-phase5-migration-061.ts",
    "test:e2e": "npm run build && playwright test tests/e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "mammoth": "^1.12.3",
    "next": "16.3.2",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.86.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "pg": "^8.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
